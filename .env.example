# --- Vercel project environment variables (relay function) ---
# Settings > Environment Variables. All three are required.

# Copy from the Linear webhook screen after creating the webhook.
LINEAR_WEBHOOK_SECRET=

# GitHub fine-grained PAT with Contents: read & write on this repo only.
GITHUB_DISPATCH_TOKEN=

# owner/repo, e.g. garik/agent
GITHUB_REPO=

# Optional — defaults shown. Must match Linear exactly (case-insensitive).
LINEAR_TRIGGER_LABEL=ai-agent
LINEAR_TRIGGER_STATE=In Progress
